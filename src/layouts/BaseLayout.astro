---
import '../styles/global.css';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'EAL ENTERPRISES — Web development & software custom pentru startup-uri și business-uri. Execuție rapidă, cod curat, rezultate concrete.',
  ogImage = '/og-image.png',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'EAL ENTERPRISES',
  url: Astro.site?.toString() || 'https://eal-enterprises.ro',
  logo: new URL('/favicon.svg', Astro.site).toString(),
  description: 'Web development & software custom pentru startup-uri și business-uri.',
  contactPoint: {
    '@type': 'ContactPoint',
    email: 'contact@eal-enterprises.ro',
    contactType: 'customer service',
    availableLanguage: ['Romanian', 'English'],
  },
  sameAs: [
    'https://github.com/lucadumitrascu-create',
    'https://linkedin.com/in/lucadumitrascu',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#f0fdfa" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:locale" content="ro_RO" />
    <meta property="og:site_name" content="EAL ENTERPRISES" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />

    <!-- Google Fonts: Outfit (headings) + DM Sans (body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,700;1,400&family=Outfit:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="min-h-screen bg-[var(--color-bg)] text-[var(--color-text)]">
    <!-- Skip to content -->
    <a href="#main-content" class="skip-link">Skip to content</a>

    <slot name="navbar" />
    <div id="main-content">
      <slot />
    </div>
    <Footer />



    <script>
      import { initI18n } from '../scripts/i18n';
      import '../scripts/scroll-animations';
      initI18n();
    </script>
  </body>
</html>
