---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import ProjectCard from '../components/ProjectCard.astro';
import projects from '../data/projects.json';
---

<BaseLayout title="Our Projects — EAL Enterprises" description="Explore our portfolio of web development projects including e-commerce platforms, portfolios, and custom web applications.">
  <Navbar slot="navbar" />
  <main class="pt-24 pb-24 sm:pb-32 relative overflow-hidden">

    <!-- Glow orbs -->
    <div class="absolute inset-0 -z-10" aria-hidden="true">
      <div class="absolute top-[10%] left-[-5%] w-[40%] h-[40%] rounded-full bg-cyan-500 opacity-[0.06] blur-[120px]"></div>
      <div class="absolute bottom-[10%] right-[-5%] w-[35%] h-[35%] rounded-full bg-indigo-500 opacity-[0.04] blur-[100px]"></div>
    </div>

    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

      <!-- Header -->
      <div class="text-center max-w-3xl mx-auto" data-animate="fade-up">
        <a href="/" class="inline-flex items-center gap-2 text-sm font-medium text-[var(--color-accent)] hover:underline no-underline hover:no-underline mb-6">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          <span data-i18n="projects.back">Back home</span>
        </a>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-[var(--color-text)]" data-i18n="projects.pageTitle">Our projects</h1>
        <p class="mt-4 text-lg text-[var(--color-text-muted)] leading-relaxed max-w-xl mx-auto" data-i18n="projects.pageDesc">
          A selection of the projects we've worked on.
        </p>
      </div>

      <!-- 2x2 grid -->
      <div class="mt-14 grid grid-cols-1 sm:grid-cols-2 gap-5 sm:gap-6 lg:gap-8">
        {projects.map((project, i) => (
          <div data-animate="fade-up" data-stagger-delay={String(i + 1)}>
            <ProjectCard
              id={project.id}
              title={project.title}
              description={project.description}
              tech={project.tech}
              url={project.url}
              image={project.image}
            />
          </div>
        ))}
      </div>

      <!-- CTA -->
      <div class="mt-20 text-center" data-animate="fade-up">
        <p class="text-lg text-[var(--color-text-muted)] mb-6" data-i18n="projects.ctaText">Have a project in mind?</p>
        <a href="/#contact"
          class="btn-amber-glass group inline-flex items-center px-7 py-3.5 rounded-xl text-base font-semibold no-underline hover:no-underline hover:-translate-y-0.5">
          <span data-i18n="projects.ctaBtn">Let's talk</span>
          <svg class="ml-2 w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

    </div>
  </main>
</BaseLayout>
