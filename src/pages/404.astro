---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Page not found | EAL ENTERPRISES">
  <section class="min-h-[80vh] flex items-center justify-center py-24">
    <div class="text-center px-4">
      <p class="text-8xl font-bold text-[var(--color-accent)]">404</p>
      <h1 class="mt-4 text-3xl sm:text-4xl font-bold text-[var(--color-text)]" data-i18n="error.title">
        Page not found
      </h1>
      <p class="mt-4 text-lg text-[var(--color-text-muted)] max-w-md mx-auto" data-i18n="error.description">
        The page you're looking for doesn't exist. Check the URL or go back home.
      </p>
      <a
        href="/"
        class="mt-8 inline-flex items-center px-6 py-3 rounded-lg text-base font-medium text-white bg-[var(--color-accent)] hover:bg-[var(--color-accent-hover)] transition-colors duration-200"
      >
        <svg class="mr-2 w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
        </svg>
        <span data-i18n="projects.back">Back home</span>
      </a>
    </div>
  </section>
</BaseLayout>
