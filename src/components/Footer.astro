---
---

<footer class="relative border-t border-transparent bg-white/70 backdrop-blur-xl overflow-hidden">
  <!-- Gradient top border -->
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-[rgba(8,145,178,0.2)] to-transparent"></div>
  <div class="absolute top-0 left-0 right-0 h-8 bg-gradient-to-b from-[rgba(8,145,178,0.04)] to-transparent pointer-events-none"></div>

  <!-- Watermark -->
  <div class="absolute inset-0 flex items-center justify-center pointer-events-none select-none" aria-hidden="true">
    <span class="text-[8rem] sm:text-[12rem] lg:text-[16rem] font-black uppercase tracking-widest text-black/[0.02] leading-none">EAL</span>
  </div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-14 sm:py-16 relative">
    <div class="flex flex-col items-start text-left">
      <a href="/" class="text-xl font-bold tracking-wider uppercase text-[var(--color-text)] no-underline hover:no-underline">
        EAL <span class="gradient-text-cyan">ENTERPRISES</span>
      </a>
      <p class="mt-3 text-sm text-[var(--color-text-muted)] leading-relaxed max-w-md" data-i18n="footer.description">
        Web development & custom software for startups and businesses. Fast execution, clean code, concrete results.
      </p>
    </div>

    <div class="mt-24 flex items-center justify-center">
      <p class="text-xs text-[var(--color-text-muted)]" data-i18n="footer.rights">
        &copy; 2026 EAL ENTERPRISES S.R.L. All rights reserved.
      </p>
    </div>
  </div>
</footer>
