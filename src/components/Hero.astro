---
---

<section class="relative min-h-[90vh] flex items-center overflow-hidden">
  <!-- Glow background -->
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute top-[-30%] right-[-15%] w-[70%] h-[70%] rounded-full bg-blue-500 opacity-[0.08] blur-[150px]"></div>
    <div class="absolute bottom-[-20%] left-[-10%] w-[50%] h-[50%] rounded-full bg-violet-500 opacity-[0.06] blur-[130px]"></div>
    <div class="absolute top-[20%] left-[30%] w-[30%] h-[30%] rounded-full bg-blue-400 opacity-[0.04] blur-[100px]"></div>
    <!-- Geometric dots pattern -->
    <div class="absolute inset-0 hero-dots opacity-[0.03]"></div>
  </div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 w-full py-20 lg:py-0">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Text -->
      <div class="hero-fade-in">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight tracking-tight text-[var(--color-text)]">
          Construim software<br />
          <span class="bg-gradient-to-r from-blue-400 to-violet-400 bg-clip-text text-transparent">care funcționează.</span>
        </h1>

        <p class="hero-fade-in-delay-1 mt-6 text-lg sm:text-xl text-[var(--color-text-muted)] max-w-lg leading-relaxed">
          Soluții digitale robuste pentru afaceri care vor să crească.
          De la idee la implementare, livrăm cod curat și rezultate concrete.
        </p>

        <div class="hero-fade-in-delay-2 mt-10 flex flex-wrap gap-4">
          <a
            href="/projects"
            class="inline-flex items-center px-7 py-3.5 rounded-lg text-base font-medium text-white bg-[var(--color-accent)] hover:bg-[var(--color-accent-hover)] no-underline hover:no-underline transition-all duration-200 shadow-lg shadow-blue-500/20 hover:shadow-blue-500/40"
          >
            Vezi proiectele
            <svg class="ml-2 w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a
            href="#contact"
            class="inline-flex items-center px-7 py-3.5 rounded-lg text-base font-medium text-[var(--color-text-muted)] border border-[var(--color-border)] hover:border-[var(--color-text-muted)] hover:text-[var(--color-text)] bg-transparent no-underline hover:no-underline transition-all duration-200"
          >
            Contactează-ne
          </a>
        </div>
      </div>

      <!-- 3D Logo -->
      <div class="hero-fade-in-delay-1 hidden lg:flex items-center justify-center" aria-hidden="true">
        <div class="logo-scene">
          <div class="logo-cube">
            <div class="logo-face logo-front">
              <span class="logo-letter">E</span>
            </div>
            <div class="logo-face logo-back">
              <span class="logo-letter-small">EAL</span>
            </div>
            <div class="logo-face logo-right">
              <span class="logo-letter">A</span>
            </div>
            <div class="logo-face logo-left">
              <span class="logo-letter">L</span>
            </div>
            <div class="logo-face logo-top"></div>
            <div class="logo-face logo-bottom"></div>
          </div>
          <!-- Glow ring -->
          <div class="logo-ring"></div>
          <!-- Floating particles -->
          <div class="logo-particle logo-particle-1"></div>
          <div class="logo-particle logo-particle-2"></div>
          <div class="logo-particle logo-particle-3"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Fade-in animations */
  @keyframes heroFadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-fade-in {
    animation: heroFadeIn 0.8s ease-out both;
  }

  .hero-fade-in-delay-1 {
    animation: heroFadeIn 0.8s ease-out 0.2s both;
  }

  .hero-fade-in-delay-2 {
    animation: heroFadeIn 0.8s ease-out 0.4s both;
  }

  /* 3D Logo Scene */
  .logo-scene {
    width: 280px;
    height: 280px;
    perspective: 800px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .logo-cube {
    width: 160px;
    height: 160px;
    position: relative;
    transform-style: preserve-3d;
    animation: logoCubeRotate 12s ease-in-out infinite;
  }

  @keyframes logoCubeRotate {
    0%, 100% {
      transform: rotateX(-15deg) rotateY(0deg);
    }
    25% {
      transform: rotateX(-10deg) rotateY(90deg);
    }
    50% {
      transform: rotateX(-15deg) rotateY(180deg);
    }
    75% {
      transform: rotateX(-10deg) rotateY(270deg);
    }
  }

  .logo-face {
    position: absolute;
    width: 160px;
    height: 160px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(59, 130, 246, 0.25);
    border-radius: 16px;
    backface-visibility: visible;
  }

  .logo-front {
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.12), rgba(139, 92, 246, 0.08));
    transform: translateZ(80px);
    box-shadow: 0 0 40px rgba(59, 130, 246, 0.1), inset 0 0 40px rgba(59, 130, 246, 0.05);
  }

  .logo-back {
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.12), rgba(59, 130, 246, 0.08));
    transform: rotateY(180deg) translateZ(80px);
    box-shadow: 0 0 40px rgba(139, 92, 246, 0.1);
  }

  .logo-right {
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.1), rgba(139, 92, 246, 0.06));
    transform: rotateY(90deg) translateZ(80px);
    box-shadow: 0 0 30px rgba(59, 130, 246, 0.08);
  }

  .logo-left {
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.1), rgba(59, 130, 246, 0.06));
    transform: rotateY(-90deg) translateZ(80px);
    box-shadow: 0 0 30px rgba(139, 92, 246, 0.08);
  }

  .logo-top {
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.15), rgba(139, 92, 246, 0.1));
    transform: rotateX(90deg) translateZ(80px);
    border-color: rgba(59, 130, 246, 0.3);
  }

  .logo-bottom {
    background: linear-gradient(135deg, rgba(10, 10, 10, 0.8), rgba(10, 10, 10, 0.6));
    transform: rotateX(-90deg) translateZ(80px);
    border-color: rgba(59, 130, 246, 0.1);
  }

  .logo-letter {
    font-family: 'Outfit', sans-serif;
    font-size: 64px;
    font-weight: 700;
    background: linear-gradient(135deg, #60a5fa, #a78bfa);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    filter: drop-shadow(0 0 20px rgba(59, 130, 246, 0.3));
  }

  .logo-letter-small {
    font-family: 'Outfit', sans-serif;
    font-size: 40px;
    font-weight: 700;
    letter-spacing: 4px;
    background: linear-gradient(135deg, #a78bfa, #60a5fa);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    filter: drop-shadow(0 0 20px rgba(139, 92, 246, 0.3));
  }

  /* Glow ring */
  .logo-ring {
    position: absolute;
    width: 240px;
    height: 240px;
    border-radius: 50%;
    border: 1px solid rgba(59, 130, 246, 0.1);
    animation: logoRingPulse 4s ease-in-out infinite;
  }

  @keyframes logoRingPulse {
    0%, 100% {
      transform: scale(1);
      opacity: 0.3;
    }
    50% {
      transform: scale(1.08);
      opacity: 0.6;
    }
  }

  /* Floating particles */
  .logo-particle {
    position: absolute;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #3b82f6;
  }

  .logo-particle-1 {
    top: 15%;
    right: 10%;
    animation: logoParticle 5s ease-in-out infinite;
    opacity: 0.6;
  }

  .logo-particle-2 {
    bottom: 20%;
    left: 8%;
    width: 3px;
    height: 3px;
    background: #a78bfa;
    animation: logoParticle 5s ease-in-out 1.5s infinite;
    opacity: 0.5;
  }

  .logo-particle-3 {
    top: 60%;
    right: 5%;
    width: 2px;
    height: 2px;
    animation: logoParticle 5s ease-in-out 3s infinite;
    opacity: 0.4;
  }

  @keyframes logoParticle {
    0%, 100% {
      transform: translateY(0) scale(1);
      opacity: 0.4;
    }
    50% {
      transform: translateY(-12px) scale(1.5);
      opacity: 0.8;
    }
  }

  /* Dot pattern */
  .hero-dots {
    background-image: radial-gradient(circle, var(--color-text) 1px, transparent 1px);
    background-size: 24px 24px;
  }
</style>
