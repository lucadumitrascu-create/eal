---
// Dev-studio hero: a ray-traced CUT glass ring (Blender, Cycles) loads in and
// latches around the centred headline like a loading indicator snapping shut.
---

<section id="hero" class="hero relative min-h-[100svh] overflow-hidden flex items-center justify-center">
  <!-- Cut glass ring, framing the centre; loads + catches on entry -->
  <div class="hero-ring-wrap" aria-hidden="true">
    <img class="hero-ring" src="/images/hero/hero-ring-v5.webp" alt="" width="2000" height="2000" fetchpriority="high" decoding="async" />
  </div>
  <div class="hero-fade" aria-hidden="true"></div>

  <div class="relative z-10 mx-auto w-full max-w-2xl px-6 text-center">
    <h1 class="hero-h1 font-['Outfit'] font-bold">
      <span class="block text-[#0c1a2a]" data-i18n="hero.title1">We build software</span>
      <span class="block text-[var(--color-accent)]" data-i18n="hero.title2">that works.</span>
    </h1>
    <div class="hero-cta-row">
      <a href="/projects" class="hero-btn btn-amber-glass hero-magnetic" data-i18n="hero.cta1">See projects</a>
      <a href="/builder" class="hero-btn btn-amber-glass hero-magnetic" data-i18n="hero.cta3">Build a mockup</a>
    </div>
  </div>
</section>

<style>
  .hero {
    background: #d3ecf5; /* uniform, single flat tone */
    margin-top: -5rem;   /* pull up under the fixed nav, cancel the navbar spacer -> no seam */
  }
  .hero-ring-wrap {
    position: absolute; z-index: 0; left: 50%; top: 49%;
    width: min(1060px, 100vw); aspect-ratio: 1; transform: translate(-50%, -50%);
    animation: ringFloat 9s ease-in-out infinite;
    pointer-events: none;
    will-change: transform;
  }
  .hero-ring {
    width: 100%; height: 100%; display: block;
    transform-origin: 50% 50%;
    will-change: transform;
    /* spin = continuous rotation (transform); fade = entrance (opacity) — no conflict */
    animation: ringSpin 26s linear infinite, ringFadeIn 1.1s ease-out both;
  }
  @keyframes ringSpin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
  @keyframes ringFadeIn { from { opacity: 0; } to { opacity: 1; } }
  @keyframes ringFloat {
    0%, 100% { transform: translate(-50%, -50%) translateY(0); }
    50% { transform: translate(-50%, -50%) translateY(-12px); }
  }
  .hero-fade {
    position: absolute; left: 0; right: 0; bottom: 0; height: 18%; z-index: 1; pointer-events: none;
    background: linear-gradient(180deg, rgba(240,253,250,0) 0%, #f0fdfa 100%);
  }

  .hero-h1 { font-size: clamp(2.5rem, 6vw, 4.6rem); line-height: 1.04; letter-spacing: -0.022em; }
  .hero-cta-row { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; justify-content: center; }

  .hero-btn {
    display: inline-flex; align-items: center; justify-content: center;
    padding: 0.82rem 1.7rem; font-weight: 600; font-size: 0.95rem;
    border-radius: 0.8rem; text-decoration: none; letter-spacing: -0.01em;
    position: relative; overflow: hidden;
  }
  .hero-btn:active { transform: scale(0.97); }

  .hero .relative > * { animation: heroIn 0.8s cubic-bezier(0.16,1,0.3,1) both; }
  .hero .relative > *:nth-child(1) { animation-delay: 0.25s; }
  .hero .relative > *:nth-child(2) { animation-delay: 0.38s; }
  @keyframes heroIn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

  @media (max-width: 640px) {
    .hero-ring-wrap { width: 92vw; top: 46%; }
    .hero-cta-row .hero-btn { flex: 1 1 auto; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-ring-wrap { animation: none; }
    .hero-ring { animation: none; opacity: 1; transform: none; }
    .hero .relative > * { animation: none; opacity: 1; transform: none; }
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fine = window.matchMedia('(hover: hover)').matches;
  if (!reduce && fine) {
    document.querySelectorAll<HTMLElement>('.hero-magnetic').forEach((el) => {
      const strength = 0.3, max = 6;
      el.addEventListener('pointermove', (e) => {
        const r = el.getBoundingClientRect();
        const cx = Math.max(-max, Math.min(max, (e.clientX - (r.left + r.width / 2)) * strength));
        const cy = Math.max(-max, Math.min(max, (e.clientY - (r.top + r.height / 2)) * strength));
        el.style.transform = `translate(${cx}px, ${cy}px)`;
      });
      el.addEventListener('pointerleave', () => { el.style.transform = ''; });
    });
  }
</script>
