---
---

<section class="relative min-h-[90vh] flex items-center overflow-hidden">
  <!-- Glow background — enhanced multi-layer -->
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute top-[-30%] right-[-15%] w-[70%] h-[70%] rounded-full bg-blue-500 opacity-[0.10] blur-[150px] hero-orb-1"></div>
    <div class="absolute bottom-[-20%] left-[-10%] w-[50%] h-[50%] rounded-full bg-violet-500 opacity-[0.08] blur-[130px] hero-orb-2"></div>
    <div class="absolute top-[20%] left-[30%] w-[30%] h-[30%] rounded-full bg-indigo-400 opacity-[0.06] blur-[100px] hero-orb-3"></div>
    <!-- Grid pattern -->
    <div class="absolute inset-0 hero-grid opacity-[0.03]"></div>
  </div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 w-full py-12 sm:py-16 lg:py-0">
    <div class="grid lg:grid-cols-2 gap-8 lg:gap-16 items-center">
      <!-- 3D Logo (mobile: above text, desktop: right side) -->
      <div class="hero-fade-in-delay-1 flex items-center justify-center lg:order-2" aria-hidden="true">
        <div class="relative">
          <!-- Glow behind canvas -->
          <div class="absolute inset-0 bg-blue-500/10 blur-[60px] rounded-full scale-75"></div>
          <canvas id="logo3d" class="logo-canvas relative"></canvas>
        </div>
      </div>

      <!-- Text -->
      <div class="hero-fade-in lg:order-1">
        <h1 class="text-3xl sm:text-4xl lg:text-6xl font-bold leading-tight tracking-tight text-[var(--color-text)] text-center lg:text-left">
          <span data-i18n="hero.title1">We build software</span><br />
          <span class="bg-gradient-to-r from-blue-400 via-indigo-400 to-violet-400 bg-clip-text text-transparent" data-i18n="hero.title2">that works.</span>
        </h1>

        <p class="hero-fade-in-delay-1 mt-5 sm:mt-6 text-base sm:text-lg lg:text-xl text-[var(--color-text-muted)] max-w-lg leading-relaxed text-center lg:text-left mx-auto lg:mx-0" data-i18n="hero.description">
          Robust digital solutions for businesses that want to grow.
          From idea to implementation, we deliver clean code and concrete results.
        </p>

        <div class="hero-fade-in-delay-2 mt-8 sm:mt-10 flex flex-wrap gap-4 justify-center lg:justify-start">
          <a
            href="/projects"
            class="group inline-flex items-center px-6 sm:px-7 py-3 sm:py-3.5 rounded-xl text-sm sm:text-base font-medium text-white bg-[var(--color-accent)] hover:bg-[var(--color-accent-hover)] no-underline hover:no-underline transition-all duration-300 shadow-lg shadow-blue-500/25 hover:shadow-blue-500/40 hover:scale-[1.02]"
          >
            <span data-i18n="hero.cta1">See projects</span>
            <svg class="ml-2 w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a
            href="#contact"
            class="inline-flex items-center px-6 sm:px-7 py-3 sm:py-3.5 rounded-xl text-sm sm:text-base font-medium text-[var(--color-text-muted)] border border-[var(--color-border)] hover:border-[rgba(59,130,246,0.3)] hover:text-[var(--color-text)] bg-[rgba(17,17,19,0.4)] backdrop-blur-sm no-underline hover:no-underline transition-all duration-300 hover:shadow-[0_0_20px_rgba(59,130,246,0.08)]"
            data-i18n="hero.cta2"
          >
            Contact us
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom gradient divider -->
  <div class="absolute bottom-0 left-0 right-0 section-divider"></div>
</section>

<style>
  /* Fade-in animations */
  @keyframes heroFadeIn {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-fade-in {
    animation: heroFadeIn 0.8s ease-out both;
  }

  .hero-fade-in-delay-1 {
    animation: heroFadeIn 0.8s ease-out 0.2s both;
  }

  .hero-fade-in-delay-2 {
    animation: heroFadeIn 0.8s ease-out 0.4s both;
  }

  /* Floating orbs — slow drift */
  @keyframes orbFloat1 {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(30px, -20px); }
  }
  @keyframes orbFloat2 {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(-20px, 30px); }
  }
  @keyframes orbFloat3 {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(15px, 15px); }
  }

  .hero-orb-1 { animation: orbFloat1 15s ease-in-out infinite; }
  .hero-orb-2 { animation: orbFloat2 18s ease-in-out infinite; }
  .hero-orb-3 { animation: orbFloat3 12s ease-in-out infinite; }

  /* Grid pattern (replaces dots) */
  .hero-grid {
    background-image:
      linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
    background-size: 48px 48px;
  }

  .logo-canvas {
    border-radius: 16px;
    width: 280px;
    height: 280px;
  }

  @media (min-width: 640px) {
    .logo-canvas {
      width: 360px;
      height: 360px;
    }
  }

  @media (min-width: 1024px) {
    .logo-canvas {
      width: 500px;
      height: 500px;
    }
  }
</style>

<script>
  import * as THREE from 'three';
  import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';

  function easeOut(t: number): number {
    return 1 - Math.pow(1 - Math.min(Math.max(t, 0), 1), 3);
  }

  const canvas = document.getElementById('logo3d') as HTMLCanvasElement;
  if (canvas) {
    const rect = canvas.getBoundingClientRect();
    const w = rect.width;
    const h = rect.height;

    canvas.width = w * window.devicePixelRatio;
    canvas.height = h * window.devicePixelRatio;

    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
    renderer.setPixelRatio(window.devicePixelRatio);
    renderer.setSize(w, h);
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.2;

    const scene = new THREE.Scene();

    const camera = new THREE.PerspectiveCamera(35, w / h, 0.1, 100);
    camera.position.set(0, -0.3, 8);
    camera.lookAt(0, -0.3, 0);

    // Lighting
    const ambientLight = new THREE.AmbientLight(0x4466aa, 0.6);
    scene.add(ambientLight);

    const keyLight = new THREE.DirectionalLight(0xccddff, 3);
    keyLight.position.set(3, 4, 5);
    scene.add(keyLight);

    const fillLight = new THREE.DirectionalLight(0x6688ff, 1.5);
    fillLight.position.set(-4, 2, 3);
    scene.add(fillLight);

    const rimLight = new THREE.DirectionalLight(0x3366ff, 2);
    rimLight.position.set(0, -1, -4);
    scene.add(rimLight);

    // Hologram shader — base template (will be cloned per mesh)
    const hologramShader = {
      uniforms: {
        uTime: { value: 0 },
        uColor: { value: new THREE.Color(0x0037ff) },
        uFresnelPower: { value: 1.5 },
        uScanlineScale: { value: 150.0 },
        uAlpha: { value: 0.0 },
      },
      vertexShader: `
        varying vec3 vPosition;
        varying vec3 vNormal;
        varying vec3 vViewDir;
        void main() {
          vPosition = position;
          vNormal = normalize(normalMatrix * normal);
          vec4 mvPos = modelViewMatrix * vec4(position, 1.0);
          vViewDir = normalize(-mvPos.xyz);
          gl_Position = projectionMatrix * mvPos;
        }
      `,
      fragmentShader: `
        uniform float uTime;
        uniform vec3 uColor;
        uniform float uFresnelPower;
        uniform float uScanlineScale;
        uniform float uAlpha;
        varying vec3 vPosition;
        varying vec3 vNormal;
        varying vec3 vViewDir;
        void main() {
          float fresnel = pow(1.0 - dot(vNormal, vViewDir), uFresnelPower);
          fresnel = clamp(fresnel, 0.0, 1.0);

          float scanline = sin((vPosition.y + uTime * 0.5) * uScanlineScale) * 0.5 + 0.5;
          scanline = smoothstep(0.3, 0.7, scanline);

          float flicker = sin(uTime * 3.0) * 0.03 + 0.97;

          float intensity = (0.4 + fresnel * 0.8 + scanline * 0.3) * flicker;
          vec3 color = uColor * intensity;

          color += vec3(0.3, 0.6, 1.0) * fresnel * 0.5;

          float alpha = (0.3 + fresnel * 0.5 + scanline * 0.2) * uAlpha;
          gl_FragColor = vec4(color, alpha);
        }
      `,
    };

    // Letter reveal timeline config
    const REVEAL_TIMELINE = [
      { name: 'letter_E',    startDelay: 0.0, duration: 0.5, offsetZ: 0.3  },
      { name: 'letter_A',    startDelay: 0.3, duration: 0.5, offsetZ: 0.3  },
      { name: 'letter_L',    startDelay: 0.6, duration: 0.5, offsetZ: 0.3  },
      { name: 'ENTERPRISES', startDelay: 1.0, duration: 0.6, offsetZ: -0.2 },
    ];
    const REVEAL_END = 1.8;
    const TARGET_ALPHA = 0.85;

    // Per-mesh animation state
    interface LetterState {
      mesh: THREE.Mesh;
      material: THREE.ShaderMaterial;
      startDelay: number;
      duration: number;
      offsetZ: number;
      originalZ: number;
    }

    let logoGroup: THREE.Group | null = null;
    const letterStates: LetterState[] = [];
    const clock = new THREE.Clock();
    let animationId: number;

    // Load the GLB model
    const loader = new GLTFLoader();
    loader.load('/models/eal-logo.glb', (gltf) => {
      const modelScene = gltf.scene;

      // Find meshes by name and assign individual materials
      const meshMap = new Map<string, THREE.Mesh>();
      modelScene.traverse((child) => {
        if (child instanceof THREE.Mesh) {
          meshMap.set(child.name, child);
        }
      });

      // Center and scale the whole model first
      const box = new THREE.Box3().setFromObject(modelScene);
      const center = box.getCenter(new THREE.Vector3());
      const size = box.getSize(new THREE.Vector3());

      const inner = new THREE.Group();
      inner.add(modelScene);
      modelScene.position.sub(center);

      const outer = new THREE.Group();
      const maxDim = Math.max(size.x, size.y, size.z);
      const scaleFactor = 4.5 / maxDim;
      outer.scale.setScalar(scaleFactor);
      outer.add(inner);
      scene.add(outer);

      logoGroup = outer;

      // Setup per-letter materials and initial states
      for (const config of REVEAL_TIMELINE) {
        const mesh = meshMap.get(config.name);
        if (!mesh) continue;

        // Clone material for independent alpha control
        const mat = new THREE.ShaderMaterial({
          uniforms: {
            uTime: { value: 0 },
            uColor: { value: new THREE.Color(0x0037ff) },
            uFresnelPower: { value: 1.5 },
            uScanlineScale: { value: 150.0 },
            uAlpha: { value: 0.0 },
          },
          vertexShader: hologramShader.vertexShader,
          fragmentShader: hologramShader.fragmentShader,
          transparent: true,
          side: THREE.DoubleSide,
          depthWrite: false,
          blending: THREE.AdditiveBlending,
        });

        mesh.material = mat;

        // Store original Z and apply initial offset
        const origZ = mesh.position.z;
        mesh.position.z = origZ + config.offsetZ;

        // Start at small scale for letters (not ENTERPRISES)
        if (config.name !== 'ENTERPRISES') {
          mesh.scale.setScalar(0.5);
        }

        letterStates.push({
          mesh,
          material: mat,
          startDelay: config.startDelay,
          duration: config.duration,
          offsetZ: config.offsetZ,
          originalZ: origZ,
        });
      }
    });

    // Mouse interaction
    let mouseX = 0;
    let mouseY = 0;
    document.addEventListener('mousemove', (e) => {
      mouseX = (e.clientX / window.innerWidth - 0.5) * 2;
      mouseY = (e.clientY / window.innerHeight - 0.5) * 2;
    });

    function animate() {
      animationId = requestAnimationFrame(animate);

      clock.getDelta();
      const elapsed = clock.getElapsedTime();

      // Update reveal animations per letter
      for (const ls of letterStates) {
        ls.material.uniforms.uTime.value = elapsed;

        if (elapsed < ls.startDelay) {
          // Not started yet
          ls.material.uniforms.uAlpha.value = 0;
        } else if (elapsed < ls.startDelay + ls.duration) {
          // Animating in
          const t = (elapsed - ls.startDelay) / ls.duration;
          const e = easeOut(t);

          ls.material.uniforms.uAlpha.value = TARGET_ALPHA * e;
          ls.mesh.position.z = ls.originalZ + ls.offsetZ * (1 - e);

          // Scale reveal for letters (not ENTERPRISES)
          if (ls.offsetZ > 0) {
            const s = 0.5 + 0.5 * e;
            ls.mesh.scale.setScalar(s);
          }
        } else {
          // Fully revealed
          ls.material.uniforms.uAlpha.value = TARGET_ALPHA;
          ls.mesh.position.z = ls.originalZ;
          if (ls.offsetZ > 0) {
            ls.mesh.scale.setScalar(1);
          }
        }
      }

      // Idle hover — after reveal completes
      if (logoGroup) {
        // Float up/down
        logoGroup.position.y = Math.sin(elapsed * 0.8) * 0.12;

        // Pendulum rotation ±5° (~0.087 rad) on Y, ~8s cycle
        const pendulum = Math.sin(elapsed * 0.4) * 0.087;

        // Mouse tilt
        logoGroup.rotation.x = mouseY * 0.06;
        logoGroup.rotation.y = pendulum + mouseX * 0.1;
      }

      renderer.render(scene, camera);
    }

    animate();

    // Pause animation when tab is not visible
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        cancelAnimationFrame(animationId);
        clock.stop();
      } else {
        clock.start();
        animate();
      }
    });
  }
</script>
