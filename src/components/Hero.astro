---
---

<section class="relative min-h-[90vh] flex items-center overflow-hidden">
  <!-- Glow background -->
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute top-[-30%] right-[-15%] w-[70%] h-[70%] rounded-full bg-blue-500 opacity-[0.08] blur-[150px]"></div>
    <div class="absolute bottom-[-20%] left-[-10%] w-[50%] h-[50%] rounded-full bg-violet-500 opacity-[0.06] blur-[130px]"></div>
    <div class="absolute top-[20%] left-[30%] w-[30%] h-[30%] rounded-full bg-blue-400 opacity-[0.04] blur-[100px]"></div>
    <!-- Geometric dots pattern -->
    <div class="absolute inset-0 hero-dots opacity-[0.03]"></div>
  </div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 w-full py-20 lg:py-0">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Text -->
      <div class="hero-fade-in">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight tracking-tight text-[var(--color-text)]">
          Construim software<br />
          <span class="bg-gradient-to-r from-blue-400 to-violet-400 bg-clip-text text-transparent">care funcționează.</span>
        </h1>

        <p class="hero-fade-in-delay-1 mt-6 text-lg sm:text-xl text-[var(--color-text-muted)] max-w-lg leading-relaxed">
          Soluții digitale robuste pentru afaceri care vor să crească.
          De la idee la implementare, livrăm cod curat și rezultate concrete.
        </p>

        <div class="hero-fade-in-delay-2 mt-10 flex flex-wrap gap-4">
          <a
            href="/projects"
            class="inline-flex items-center px-7 py-3.5 rounded-lg text-base font-medium text-white bg-[var(--color-accent)] hover:bg-[var(--color-accent-hover)] no-underline hover:no-underline transition-all duration-200 shadow-lg shadow-blue-500/20 hover:shadow-blue-500/40"
          >
            Vezi proiectele
            <svg class="ml-2 w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a
            href="#contact"
            class="inline-flex items-center px-7 py-3.5 rounded-lg text-base font-medium text-[var(--color-text-muted)] border border-[var(--color-border)] hover:border-[var(--color-text-muted)] hover:text-[var(--color-text)] bg-transparent no-underline hover:no-underline transition-all duration-200"
          >
            Contactează-ne
          </a>
        </div>
      </div>

      <!-- 3D Glass Logo -->
      <div class="hero-fade-in-delay-1 hidden lg:flex items-center justify-center" aria-hidden="true">
        <canvas id="logo3d" width="560" height="560" style="width:560px;height:560px;"></canvas>
      </div>
    </div>
  </div>
</section>

<style>
  /* Fade-in animations */
  @keyframes heroFadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-fade-in {
    animation: heroFadeIn 0.8s ease-out both;
  }

  .hero-fade-in-delay-1 {
    animation: heroFadeIn 0.8s ease-out 0.2s both;
  }

  .hero-fade-in-delay-2 {
    animation: heroFadeIn 0.8s ease-out 0.4s both;
  }

  /* Dot pattern */
  .hero-dots {
    background-image: radial-gradient(circle, var(--color-text) 1px, transparent 1px);
    background-size: 24px 24px;
  }

  #logo3d {
    border-radius: 16px;
  }
</style>

<script>
  import * as THREE from 'three';
  import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';

  const canvas = document.getElementById('logo3d') as HTMLCanvasElement;
  if (canvas) {
    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
    renderer.setPixelRatio(window.devicePixelRatio);
    renderer.setSize(560, 560);
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.2;

    const scene = new THREE.Scene();

    const camera = new THREE.PerspectiveCamera(35, 1, 0.1, 100);
    camera.position.set(0, 0.5, 8);
    camera.lookAt(0, 0, 0);

    // Lighting
    const ambientLight = new THREE.AmbientLight(0x4466aa, 0.6);
    scene.add(ambientLight);

    const keyLight = new THREE.DirectionalLight(0xccddff, 3);
    keyLight.position.set(3, 4, 5);
    scene.add(keyLight);

    const fillLight = new THREE.DirectionalLight(0x6688ff, 1.5);
    fillLight.position.set(-4, 2, 3);
    scene.add(fillLight);

    const rimLight = new THREE.DirectionalLight(0x3366ff, 2);
    rimLight.position.set(0, -1, -4);
    scene.add(rimLight);

    // Environment map for glass reflections
    const pmremGenerator = new THREE.PMREMGenerator(renderer);
    const envScene = new THREE.Scene();
    envScene.background = new THREE.Color(0x0a0a1a);

    // Add some colored lights to env for interesting reflections
    const envLight1 = new THREE.PointLight(0x3b82f6, 50, 20);
    envLight1.position.set(5, 5, 5);
    envScene.add(envLight1);
    const envLight2 = new THREE.PointLight(0x8b5cf6, 50, 20);
    envLight2.position.set(-5, 3, -3);
    envScene.add(envLight2);
    const envLight3 = new THREE.PointLight(0xffffff, 30, 20);
    envLight3.position.set(0, -5, 5);
    envScene.add(envLight3);

    const envMap = pmremGenerator.fromScene(envScene).texture;

    // Glass material for EAL (clear glass with blue tint)
    const glassMaterialEAL = new THREE.MeshPhysicalMaterial({
      color: 0xddeeff,
      metalness: 0.0,
      roughness: 0.05,
      transmission: 0.92,
      thickness: 1.5,
      ior: 1.5,
      envMap: envMap,
      envMapIntensity: 1.5,
      clearcoat: 1.0,
      clearcoatRoughness: 0.05,
      transparent: true,
      opacity: 0.95,
    });

    // Glass material for ENTERPRISES (blue glass)
    const glassMaterialENT = new THREE.MeshPhysicalMaterial({
      color: 0x2563eb,
      metalness: 0.0,
      roughness: 0.05,
      transmission: 0.85,
      thickness: 2.0,
      ior: 1.5,
      envMap: envMap,
      envMapIntensity: 2.0,
      clearcoat: 1.0,
      clearcoatRoughness: 0.05,
      transparent: true,
      opacity: 0.95,
    });

    let logoGroup: THREE.Group | null = null;
    let mixer: THREE.AnimationMixer | null = null;
    const clock = new THREE.Clock();

    // Load the GLB model
    const loader = new GLTFLoader();
    loader.load('/models/eal-logo.glb', (gltf) => {
      logoGroup = gltf.scene;

      // Apply glass materials
      logoGroup.traverse((child) => {
        if (child instanceof THREE.Mesh) {
          // Check which text object this is by name or position
          const name = child.name.toLowerCase();
          if (name.includes('001') || child.position.z < 0) {
            child.material = glassMaterialENT;
          } else {
            child.material = glassMaterialEAL;
          }
        }
      });

      // Center and scale the logo
      const box = new THREE.Box3().setFromObject(logoGroup);
      const center = box.getCenter(new THREE.Vector3());
      logoGroup.position.sub(center);

      const size = box.getSize(new THREE.Vector3());
      const maxDim = Math.max(size.x, size.y, size.z);
      const scale = 4 / maxDim;
      logoGroup.scale.setScalar(scale);

      // Rotate to face camera (Blender Z-up → Three.js Y-up)
      logoGroup.rotation.x = -Math.PI / 2;

      scene.add(logoGroup);

      // Setup animation mixer
      if (gltf.animations.length > 0) {
        mixer = new THREE.AnimationMixer(logoGroup);
        gltf.animations.forEach((clip) => {
          const action = mixer!.clipAction(clip);
          action.play();
        });
      }
    });

    // Mouse interaction - subtle follow
    let mouseX = 0;
    let mouseY = 0;
    document.addEventListener('mousemove', (e) => {
      mouseX = (e.clientX / window.innerWidth - 0.5) * 2;
      mouseY = (e.clientY / window.innerHeight - 0.5) * 2;
    });

    // Animation loop
    function animate() {
      requestAnimationFrame(animate);

      const delta = clock.getDelta();
      const elapsed = clock.getElapsedTime();

      if (mixer) {
        mixer.update(delta);
      }

      if (logoGroup) {
        // Float effect
        logoGroup.position.y = Math.sin(elapsed * 0.8) * 0.15;

        // Base rotation (Blender Z-up → Three.js Y-up) + gentle Y turntable + mouse follow
        logoGroup.rotation.x = -Math.PI / 2 + mouseY * 0.1;
        logoGroup.rotation.y = elapsed * 0.3 + mouseX * 0.15;
        logoGroup.rotation.z = 0;
      }

      renderer.render(scene, camera);
    }

    animate();
  }
</script>
