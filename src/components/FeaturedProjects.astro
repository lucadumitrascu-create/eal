---
import ProjectCard from './ProjectCard.astro';
import projects from '../data/projects.json';

const featured = projects.filter((p) => p.featured);
---

<section id="proiecte" class="py-24 sm:py-32 bg-gray-50/50">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <p class="text-sm font-semibold uppercase tracking-widest text-[var(--color-accent)]">Portofoliu</p>
      <h2 class="mt-3 text-3xl sm:text-4xl font-bold text-[var(--color-text)]">Proiecte recente</h2>
      <p class="mt-4 text-lg text-[var(--color-text-muted)] leading-relaxed">
        O selecție din proiectele livrate recent de echipa noastră.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {featured.map((project) => (
        <ProjectCard
          title={project.title}
          description={project.description}
          tech={project.tech}
          url={project.url}
          image={project.image}
        />
      ))}
    </div>

    <div class="mt-14 text-center">
      <a
        href="/projects"
        class="inline-flex items-center px-7 py-3.5 rounded-lg text-base font-medium text-[var(--color-accent)] border-2 border-[var(--color-accent)] hover:bg-[var(--color-accent-light)] no-underline hover:no-underline transition-colors duration-200"
      >
        Vezi toate proiectele
        <svg class="ml-2 w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>
</section>
