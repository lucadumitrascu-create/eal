---
import ProjectCard from './ProjectCard.astro';
import projects from '../data/projects.json';

const featured = projects.filter((p) => p.featured);
---

<section id="proiecte" class="relative py-24 sm:py-32 overflow-hidden">
  <!-- Section glow orbs -->
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute top-[5%] left-[10%] w-[40%] h-[40%] rounded-full bg-blue-500 opacity-[0.06] blur-[120px]"></div>
    <div class="absolute bottom-[15%] right-[-5%] w-[35%] h-[35%] rounded-full bg-violet-500 opacity-[0.05] blur-[100px]"></div>
  </div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-16 projects-section-reveal">
      <p class="text-sm font-semibold uppercase tracking-widest text-[var(--color-accent)]" data-i18n="projects.title">Featured Projects</p>
      <h2 class="mt-3 text-3xl sm:text-4xl font-bold text-[var(--color-text)]" data-i18n="projects.subtitle">A selection of our recent work</h2>
    </div>

    <div class="grid sm:grid-cols-2 gap-6 lg:gap-8">
      {featured.map((project, i) => (
        <div class="projects-section-reveal" style={`transition-delay: ${(i + 1) * 100}ms`}>
          <ProjectCard
            title={project.title}
            description={project.description}
            tech={project.tech}
            url={project.url}
            image={project.image}
          />
        </div>
      ))}
    </div>

    <div class="mt-14 text-center projects-section-reveal" style="transition-delay: 500ms">
      <a
        href="/projects"
        class="group inline-flex items-center px-7 py-3.5 rounded-xl text-base font-medium text-[var(--color-text-muted)] border border-[var(--color-border)] hover:border-[rgba(59,130,246,0.3)] hover:text-[var(--color-text)] bg-[rgba(17,17,19,0.4)] backdrop-blur-sm no-underline hover:no-underline transition-all duration-300 hover:shadow-[0_0_20px_rgba(59,130,246,0.08)]"
      >
        <span data-i18n="projects.viewAll">View all projects</span>
        <svg class="ml-2 w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>

  <!-- Bottom divider -->
  <div class="absolute bottom-0 left-0 right-0 section-divider"></div>
</section>

<style>
  .projects-section-reveal {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.7s ease-out, transform 0.7s ease-out;
  }

  .projects-section-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
        }
      });
    },
    { threshold: 0.1 }
  );

  document.querySelectorAll('.projects-section-reveal').forEach((el) => observer.observe(el));
</script>
