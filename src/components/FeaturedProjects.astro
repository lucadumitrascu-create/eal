---
import ProjectCard from './ProjectCard.astro';
import projects from '../data/projects.json';

const featured = projects.filter((p) => p.featured);
---

<section id="proiecte" class="relative py-24 sm:py-32 overflow-hidden section-transition">
  <!-- Section glow orbs -->
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute top-[5%] left-[10%] w-[40%] h-[40%] rounded-full bg-cyan-500 opacity-[0.06] blur-[120px]"></div>
    <div class="absolute bottom-[15%] right-[-5%] w-[35%] h-[35%] rounded-full bg-indigo-500 opacity-[0.04] blur-[100px]"></div>
  </div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-16" data-animate="fade-up">
      <p class="text-sm font-semibold uppercase tracking-widest text-[var(--color-accent)]" data-i18n="projects.title">Featured Projects</p>
      <h2 class="mt-3 text-3xl sm:text-4xl lg:text-5xl font-bold text-[var(--color-text)]" data-i18n="projects.subtitle">A selection of our recent work</h2>
    </div>

    <!-- Desktop: hero card first (full-width), rest in grid -->
    <div class="hidden md:block space-y-6">
      {featured.length > 0 && (
        <div data-animate="scale-in">
          <ProjectCard
            title={featured[0].title}
            description={featured[0].description}
            tech={featured[0].tech}
            url={featured[0].url}
            image={featured[0].image}
            isHero={true}
          />
        </div>
      )}
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {featured.slice(1).map((project, i) => (
          <div data-animate="fade-up" data-stagger-delay={String(i + 1)}>
            <ProjectCard
              title={project.title}
              description={project.description}
              tech={project.tech}
              url={project.url}
              image={project.image}
            />
          </div>
        ))}
      </div>
    </div>

    <!-- Mobile: swipeable horizontal scroll -->
    <div class="md:hidden flex gap-4 overflow-x-auto snap-x snap-mandatory pb-4 -mx-4 px-4 scrollbar-hide">
      {featured.map((project, i) => (
        <div class="snap-center shrink-0 w-[85vw] max-w-[340px]" data-animate="fade-up" data-stagger-delay={String(i)}>
          <ProjectCard
            title={project.title}
            description={project.description}
            tech={project.tech}
            url={project.url}
            image={project.image}
          />
        </div>
      ))}
    </div>

    <div class="mt-14 text-center" data-animate="fade-up">
      <a
        href="/projects"
        class="magnetic-btn group inline-flex items-center px-7 py-3.5 rounded-xl text-base font-medium text-[var(--color-text-muted)] border border-[var(--color-border)] hover:border-[var(--color-border-hover)] hover:text-[var(--color-text)] bg-[var(--color-surface-neutral)] backdrop-blur-sm no-underline hover:no-underline transition-all duration-300 hover:shadow-[0_0_20px_rgba(6,182,212,0.08)]"
      >
        <span data-i18n="projects.viewAll">View all projects</span>
        <svg class="ml-2 w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>

  <!-- Bottom gradient transition -->
  <div class="absolute bottom-0 left-0 right-0 h-16 bg-gradient-to-t from-[#f0fdfa] to-transparent pointer-events-none"></div>
</section>

<style>
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
</style>
