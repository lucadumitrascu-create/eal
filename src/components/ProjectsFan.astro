---
import projects from '../data/projects.json';
import ProjectsScene from './ProjectsScene.tsx';

/**
 * Real WebGL 3D project cards (three.js / react-three-fiber): rounded boxes with
 * thickness, the site screenshot textured on the front face, soft lighting,
 * ambient float, hover tilt-toward-cursor + lift, click -> external link.
 * Renders client-only (WebGL has no SSR). Placement unchanged: above "Let's talk".
 */
const cards = projects.map((p) => ({ url: p.url, texture: p.image, title: p.title }));
---

<section id="projects-fan" class="relative overflow-hidden py-16 sm:py-24">
  <div class="mx-auto max-w-6xl px-6">
    <ProjectsScene client:only="react" cards={cards} />
  </div>
</section>
