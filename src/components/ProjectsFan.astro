---
import projects from '../data/projects.json';

/**
 * Overlapping project-card cluster with a per-card hover-lift, modelled on the
 * "Works with every agent" section of tasteskill.dev. Pure CSS :hover — no JS,
 * no mouse-parallax, no drag. Each card keeps a FIXED base tilt; on hover only
 * that card lifts, scales, deepens its shadow and rises to the front.
 */
const layout = [
  { pos: -1.5, ty: -8, rot: -3, z: 1 },
  { pos: -0.5, ty: 6, rot: 2, z: 4 },
  { pos: 0.5, ty: -6, rot: -2, z: 3 },
  { pos: 1.5, ty: 8, rot: 3, z: 2 },
];
---

<section id="projects-fan" class="relative overflow-hidden py-16 sm:py-24">
  <div class="mx-auto max-w-5xl px-6">
    <div class="ov-cluster">
      {projects.map((project, i) => {
        const l = layout[i % layout.length];
        return (
          <a
            href={project.url}
            target="_blank"
            rel="noopener noreferrer"
            class="ov-card"
            style={`--pos:${l.pos}; --ty:${l.ty}px; --rot:${l.rot}deg; --z:${l.z};`}
            aria-label={project.title}
          >
            <img src={project.image} alt={project.title} loading="lazy" width="640" height="360" />
          </a>
        );
      })}
    </div>
  </div>
</section>

<style>
  .ov-cluster {
    position: relative;
    margin-inline: auto;
    width: 100%;
    --cardw: 140px;
    --gap: 50px;
    height: 200px;
  }
  @media (min-width: 640px) {
    .ov-cluster { --cardw: 200px; --gap: 90px; height: 240px; }
  }
  @media (min-width: 1024px) {
    .ov-cluster { --cardw: 268px; --gap: 144px; height: 280px; }
  }

  .ov-card {
    position: absolute;
    top: 50%;
    left: 50%;
    width: var(--cardw);
    z-index: var(--z);
    border-radius: 18px;
    overflow: hidden;
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.06);
    filter: drop-shadow(0 22px 32px rgba(20, 20, 20, 0.18));
    transform: translate(calc(-50% + var(--pos) * var(--gap)), calc(-50% + var(--ty))) rotate(var(--rot));
    transition: transform 0.5s cubic-bezier(0, 0, 0.2, 1), filter 0.5s cubic-bezier(0, 0, 0.2, 1);
    will-change: transform;
    text-decoration: none;
  }
  .ov-card img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  /* Per-card hover lift — desktop only (≥1024px), like the reference's lg:hover.
     On tablet/touch there's no lift, just the static tilted overlap. */
  @media (min-width: 1024px) {
    .ov-card:hover {
      transform: translate(calc(-50% + var(--pos) * var(--gap)), calc(-50% + var(--ty) - 10px)) rotate(var(--rot)) scale(1.04);
      filter: drop-shadow(0 32px 48px rgba(20, 20, 20, 0.28));
      z-index: 50;
    }
  }

  /* Keep the static tilt + overlap; disable the lift entirely. */
  @media (prefers-reduced-motion: reduce) {
    .ov-card { transition: none; }
    .ov-card:hover {
      transform: translate(calc(-50% + var(--pos) * var(--gap)), calc(-50% + var(--ty))) rotate(var(--rot));
      filter: drop-shadow(0 22px 32px rgba(20, 20, 20, 0.18));
      z-index: var(--z);
    }
  }
</style>
