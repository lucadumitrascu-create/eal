---
interface Props {
  title: string;
  description: string;
  tech: string[];
  url: string;
  image: string;
}

const { title, description, tech, url, image } = Astro.props;
---

<a href={url} target="_blank" rel="noopener noreferrer" class="group block rounded-xl border border-[var(--color-border)] overflow-hidden no-underline hover:no-underline transition-all duration-300 hover:-translate-y-1 hover:shadow-lg hover:border-[var(--color-accent)]/20">
  <div class="aspect-video overflow-hidden bg-[var(--color-accent-light)]">
    <img
      src={image}
      alt={`Screenshot proiect ${title}`}
      loading="lazy"
      decoding="async"
      width="640"
      height="360"
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
  </div>
  <div class="p-6">
    <h3 class="text-lg font-semibold text-[var(--color-text)] group-hover:text-[var(--color-accent)] transition-colors duration-200">{title}</h3>
    <p class="mt-2 text-sm text-[var(--color-text-muted)] leading-relaxed">{description}</p>
    <div class="mt-4 flex flex-wrap gap-2">
      {tech.map((t) => (
        <span class="inline-block px-2.5 py-0.5 text-xs font-medium rounded-full bg-gray-100 text-[var(--color-text-muted)]">
          {t}
        </span>
      ))}
    </div>
  </div>
</a>
