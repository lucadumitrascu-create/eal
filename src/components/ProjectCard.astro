---
interface Props {
  title: string;
  description: string;
  tech: string[];
  url: string;
  image: string;
  isHero?: boolean;
}

const { title, description, tech, url, image, isHero = false } = Astro.props;

// Tech tag color mapping
const techColors: Record<string, string> = {
  'React': '6, 182, 212',
  'Next.js': '30, 30, 30',
  'Astro': '245, 158, 11',
  'Tailwind': '6, 182, 212',
  'HTML': '239, 68, 68',
  'CSS': '59, 130, 246',
  'JavaScript': '245, 158, 11',
  'JS': '245, 158, 11',
  'Web3': '139, 92, 246',
  'Solana': '139, 92, 246',
  'Vercel': '30, 30, 30',
  'TypeScript': '59, 130, 246',
};

function getTagColor(t: string): string {
  return techColors[t] || '161, 161, 170';
}
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class:list={[
    'group block relative rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface-neutral)] backdrop-blur-xl overflow-hidden no-underline hover:no-underline transition-all duration-400 hover:-translate-y-1.5 hover:border-[rgba(6,182,212,0.2)] hover:shadow-[0_0_40px_rgba(6,182,212,0.06),0_0_80px_rgba(99,102,241,0.03)]',
    isHero ? 'md:flex md:flex-row' : '',
  ]}
>
  <!-- Top highlight line -->
  <div class="absolute top-0 left-[10%] right-[10%] h-px bg-gradient-to-r from-transparent via-black/[0.04] to-transparent z-10"></div>

  <!-- Image with browser mockup frame -->
  <div class:list={['overflow-hidden bg-[var(--color-bg-card)] relative', isHero ? 'md:w-3/5' : '']}>
    <!-- Browser chrome bar -->
    <div class="absolute top-0 left-0 right-0 h-7 bg-[rgba(245,245,248,0.95)] backdrop-blur-sm z-10 flex items-center px-3 gap-1.5 border-b border-black/[0.06]">
      <span class="w-2.5 h-2.5 rounded-full bg-[#FF5F57]"></span>
      <span class="w-2.5 h-2.5 rounded-full bg-[#FEBC2E]"></span>
      <span class="w-2.5 h-2.5 rounded-full bg-[#28C840]"></span>
      <span class="ml-3 text-[0.6rem] text-[var(--color-text-muted)] opacity-40 truncate">{url.replace('https://', '')}</span>
    </div>
    <div class="aspect-[16/10] pt-7">
      <img
        src={image}
        alt={`Screenshot proiect ${title}`}
        loading="lazy"
        decoding="async"
        width="640"
        height="400"
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
      />
    </div>
    <!-- Slide-up overlay on hover -->
    <div class="absolute inset-0 top-7 flex items-end bg-gradient-to-t from-[rgba(255,255,255,0.95)] via-[rgba(255,255,255,0.6)] to-transparent translate-y-full group-hover:translate-y-0 transition-transform duration-400 ease-out p-6">
      <p class="text-sm text-[var(--color-text)] leading-relaxed">{description}</p>
    </div>
  </div>

  <!-- Content -->
  <div class:list={['p-6', isHero ? 'md:w-2/5 md:flex md:flex-col md:justify-center md:p-8' : '']}>
    <h3 class="text-lg font-semibold text-[var(--color-text)] group-hover:text-[var(--color-accent)] transition-colors duration-200">{title}</h3>
    <p class:list={['mt-2 text-sm text-[var(--color-text-muted)] leading-relaxed', isHero ? '' : 'line-clamp-2']}>{description}</p>
    <div class="mt-4 flex flex-wrap gap-2">
      {tech.map((t) => {
        const color = getTagColor(t);
        return (
          <span
            class="inline-block px-3 py-1 text-xs font-medium rounded-lg border"
            style={`background: rgba(${color}, 0.08); color: rgba(${color}, 0.9); border-color: rgba(${color}, 0.15);`}
          >
            {t}
          </span>
        );
      })}
    </div>
    <!-- View arrow -->
    <div class="mt-4 flex items-center gap-1 text-sm font-medium text-[var(--color-accent)] opacity-0 group-hover:opacity-100 transition-opacity duration-300">
      <span>View project</span>
      <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </div>
  </div>
</a>
