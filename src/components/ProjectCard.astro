---
interface Props {
  title: string;
  description: string;
  tech: string[];
  url: string;
  image: string;
  isHero?: boolean;
}

const { title, description, tech, url, image, isHero = false } = Astro.props;

const techColors: Record<string, string> = {
  'React': '6, 182, 212',
  'Next.js': '30, 30, 30',
  'Astro': '245, 158, 11',
  'Tailwind': '6, 182, 212',
  'Tailwind CSS': '6, 182, 212',
  'HTML': '239, 68, 68',
  'CSS': '59, 130, 246',
  'JavaScript': '245, 158, 11',
  'JS': '245, 158, 11',
  'Web3': '139, 92, 246',
  'Solana': '139, 92, 246',
  'Vercel': '30, 30, 30',
  'TypeScript': '59, 130, 246',
};

function getTagColor(t: string): string {
  return techColors[t] || '161, 161, 170';
}
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class:list={[
    'project-card group block relative no-underline hover:no-underline',
    isHero ? 'md:flex md:flex-row md:items-stretch md:gap-8' : '',
  ]}
>
  <!-- Image -->
  <div class:list={[
    'relative overflow-hidden rounded-2xl',
    isHero ? 'md:w-3/5' : '',
  ]}>
    <div class="aspect-[16/10] overflow-hidden rounded-2xl bg-gray-100">
      <img
        src={image}
        alt={title}
        loading="lazy"
        decoding="async"
        width="640"
        height="400"
        class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
      />
    </div>
    <!-- Subtle inner shadow for depth -->
    <div class="absolute inset-0 rounded-2xl shadow-[inset_0_0_0_1px_rgba(0,0,0,0.06)] pointer-events-none"></div>
  </div>

  <!-- Content -->
  <div class:list={[
    'mt-5',
    isHero ? 'md:w-2/5 md:mt-0 md:flex md:flex-col md:justify-center md:py-4' : '',
  ]}>
    <h3 class:list={[
      'font-semibold text-[var(--color-text)] group-hover:text-[var(--color-accent)] transition-colors duration-300',
      isHero ? 'text-2xl lg:text-3xl' : 'text-lg',
    ]}>{title}</h3>

    <p class:list={[
      'mt-2 text-[var(--color-text-muted)] leading-relaxed',
      isHero ? 'text-base' : 'text-sm line-clamp-2',
    ]}>{description}</p>

    <div class:list={['flex flex-wrap gap-2', isHero ? 'mt-5' : 'mt-3']}>
      {tech.map((t) => {
        const color = getTagColor(t);
        return (
          <span
            class="inline-block px-2.5 py-0.5 text-xs font-medium rounded-md"
            style={`background: rgba(${color}, 0.08); color: rgba(${color}, 0.85);`}
          >
            {t}
          </span>
        );
      })}
    </div>

    <div class:list={[
      'flex items-center gap-1.5 text-sm font-medium text-[var(--color-accent)] opacity-0 group-hover:opacity-100 transition-all duration-300',
      isHero ? 'mt-6' : 'mt-4',
    ]}>
      <span>View project</span>
      <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </div>
  </div>
</a>

<style>
  .project-card {
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .project-card:hover {
    transform: translateY(-4px);
  }
</style>
