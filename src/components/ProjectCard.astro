---
interface Props {
  title: string;
  description: string;
  tech: string[];
  url: string;
  image: string;
}

const { title, description, tech, url, image } = Astro.props;
---

<a href={url} target="_blank" rel="noopener noreferrer" class="group block relative rounded-2xl border border-[var(--color-border)] bg-[rgba(17,17,19,0.5)] backdrop-blur-xl overflow-hidden no-underline hover:no-underline transition-all duration-400 hover:-translate-y-1.5 hover:shadow-[0_0_40px_rgba(59,130,246,0.07),0_0_80px_rgba(139,92,246,0.03)] hover:border-[rgba(59,130,246,0.2)]">
  <!-- Top highlight line -->
  <div class="absolute top-0 left-[10%] right-[10%] h-px bg-gradient-to-r from-transparent via-white/[0.06] to-transparent z-10"></div>

  <div class="aspect-video overflow-hidden bg-[var(--color-bg-card)]">
    <img
      src={image}
      alt={`Screenshot proiect ${title}`}
      loading="lazy"
      decoding="async"
      width="640"
      height="360"
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
    <!-- Image overlay gradient -->
    <div class="absolute inset-0 bg-gradient-to-t from-[rgba(10,10,10,0.4)] to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
  </div>
  <div class="p-6">
    <h3 class="text-lg font-semibold text-[var(--color-text)] group-hover:text-[var(--color-accent)] transition-colors duration-200">{title}</h3>
    <p class="mt-2 text-sm text-[var(--color-text-muted)] leading-relaxed">{description}</p>
    <div class="mt-4 flex flex-wrap gap-2">
      {tech.map((t) => (
        <span class="inline-block px-3 py-1 text-xs font-medium rounded-lg bg-[var(--color-accent-light)] text-[var(--color-accent)] border border-[rgba(59,130,246,0.1)]">
          {t}
        </span>
      ))}
    </div>
  </div>
</a>
