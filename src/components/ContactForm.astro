---
---

<section id="contact" class="py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-16 lg:gap-24">

      <!-- Left: Form -->
      <div class="contact-reveal">
        <p class="text-sm font-semibold uppercase tracking-widest text-[var(--color-accent)]">Contact</p>
        <h2 class="mt-3 text-3xl sm:text-4xl font-bold text-[var(--color-text)]" data-i18n="contact.title">Let's talk</h2>
        <p class="mt-4 text-lg text-[var(--color-text-muted)] leading-relaxed" data-i18n="contact.subtitle">
          Have a project in mind? We'd love to hear about it.
        </p>

        <form
          action="https://formspree.io/f/YOUR_ID"
          method="POST"
          class="mt-10 space-y-6"
        >
          <div>
            <label for="name" class="block text-sm font-medium text-[var(--color-text)]" data-i18n="contact.name">Name</label>
            <input
              type="text"
              name="name"
              id="name"
              required
              autocomplete="name"
              placeholder="Name"
              data-i18n-placeholder="contact.name"
              class="mt-2 block w-full rounded-lg border border-[var(--color-border)] bg-[rgba(17,17,19,0.6)] backdrop-blur-sm px-4 py-3 text-base text-[var(--color-text)] placeholder:text-[var(--color-text-muted)]/50 transition-colors duration-200 focus:border-[var(--color-accent)] focus:ring-2 focus:ring-[var(--color-accent)]/20 focus:shadow-[0_0_12px_rgba(59,130,246,0.08)] focus:outline-none"
            />
          </div>

          <div>
            <label for="email" class="block text-sm font-medium text-[var(--color-text)]" data-i18n="contact.email">Email</label>
            <input
              type="email"
              name="email"
              id="email"
              required
              autocomplete="email"
              placeholder="email@example.com"
              data-i18n-placeholder="contact.email"
              class="mt-2 block w-full rounded-lg border border-[var(--color-border)] bg-[rgba(17,17,19,0.6)] backdrop-blur-sm px-4 py-3 text-base text-[var(--color-text)] placeholder:text-[var(--color-text-muted)]/50 transition-colors duration-200 focus:border-[var(--color-accent)] focus:ring-2 focus:ring-[var(--color-accent)]/20 focus:shadow-[0_0_12px_rgba(59,130,246,0.08)] focus:outline-none"
            />
          </div>

          <div>
            <label for="message" class="block text-sm font-medium text-[var(--color-text)]" data-i18n="contact.message">Message</label>
            <textarea
              name="message"
              id="message"
              required
              rows="5"
              placeholder="Message"
              data-i18n-placeholder="contact.message"
              class="mt-2 block w-full rounded-lg border border-[var(--color-border)] bg-[rgba(17,17,19,0.6)] backdrop-blur-sm px-4 py-3 text-base text-[var(--color-text)] placeholder:text-[var(--color-text-muted)]/50 transition-colors duration-200 focus:border-[var(--color-accent)] focus:ring-2 focus:ring-[var(--color-accent)]/20 focus:outline-none resize-y"
            ></textarea>
          </div>

          <button
            type="submit"
            class="inline-flex items-center px-7 py-3.5 rounded-lg text-base font-medium text-white bg-[var(--color-accent)] hover:bg-[var(--color-accent-hover)] transition-all duration-200 shadow-lg shadow-blue-500/20 hover:shadow-blue-500/40 cursor-pointer"
          >
            <span data-i18n="contact.send">Send message</span>
            <svg class="ml-2 w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
            </svg>
          </button>
        </form>
      </div>

      <!-- Right: Contact info -->
      <div class="contact-reveal contact-reveal-delay lg:pt-20">
        <div class="rounded-xl border border-[var(--color-border)] bg-[rgba(17,17,19,0.6)] backdrop-blur-sm p-8 sm:p-10">
          <h3 class="text-lg font-semibold text-[var(--color-text)]" data-i18n="contact.info.title">Contact information</h3>

          <div class="mt-8 space-y-6">
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-[var(--color-accent-light)] flex items-center justify-center">
                <svg class="w-5 h-5 text-[var(--color-accent)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                </svg>
              </div>
              <div>
                <p class="text-sm font-medium text-[var(--color-text)]">Email</p>
                <a href="mailto:contact@eal-enterprises.com" class="mt-1 text-base text-[var(--color-accent)] hover:underline" data-i18n="contact.info.email">
                  contact@eal-enterprises.ro
                </a>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-[var(--color-accent-light)] flex items-center justify-center">
                <svg class="w-5 h-5 text-[var(--color-accent)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <p class="text-sm font-medium text-[var(--color-text)]" data-i18n="contact.info.response">We respond within 48 hours</p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-[var(--color-accent-light)] flex items-center justify-center">
                <svg class="w-5 h-5 text-[var(--color-accent)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                </svg>
              </div>
              <div>
                <p class="text-sm font-medium text-[var(--color-text)]">Location</p>
                <p class="mt-1 text-base text-[var(--color-text-muted)]">Remote — anywhere in Europe</p>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .contact-reveal {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.8s ease-out, transform 0.8s ease-out;
  }

  .contact-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .contact-reveal-delay {
    transition-delay: 0.2s;
  }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
        }
      });
    },
    { threshold: 0.1 }
  );

  document.querySelectorAll('.contact-reveal').forEach((el) => observer.observe(el));
</script>
