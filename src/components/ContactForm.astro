---
---

<section id="contact" class="relative py-24 sm:py-32 overflow-hidden section-transition">
  <!-- Section glow orbs -->
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute top-[15%] right-[5%] w-[40%] h-[40%] rounded-full bg-cyan-500 opacity-[0.05] blur-[120px]"></div>
    <div class="absolute bottom-[10%] left-[-5%] w-[35%] h-[35%] rounded-full bg-amber-500 opacity-[0.03] blur-[100px]"></div>
  </div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-16 lg:gap-24">

      <!-- Left: Form -->
      <div data-animate="fade-right">
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-[var(--color-text)]" data-i18n="contact.title">Let's talk</h2>
        <p class="mt-4 text-lg text-[var(--color-text-muted)] leading-relaxed" data-i18n="contact.subtitle">
          Have a project in mind? We'd love to hear about it.
        </p>

        <form
          id="contact-form"
          action="https://formspree.io/f/xnjgbnnr"
          method="POST"
          class="mt-10 space-y-6"
        >
          <!-- Name — floating label -->
          <div class="floating-label-group">
            <input
              type="text"
              name="name"
              id="name"
              required
              autocomplete="name"
              placeholder=" "
              class="contact-input block w-full rounded-xl border border-[var(--color-border)] bg-[var(--color-surface-neutral)] backdrop-blur-xl px-4 pt-6 pb-2 text-base text-[var(--color-text)] transition-all duration-300 focus:border-[var(--color-accent)] focus:ring-2 focus:ring-[var(--color-accent)]/20 focus:shadow-[0_0_20px_rgba(6,182,212,0.08)] focus:outline-none hover:border-[rgba(0,0,0,0.15)]"
            />
            <label for="name" data-i18n="contact.name">Name</label>
          </div>

          <!-- Email — floating label -->
          <div class="floating-label-group">
            <input
              type="email"
              name="email"
              id="email"
              required
              autocomplete="email"
              placeholder=" "
              class="contact-input block w-full rounded-xl border border-[var(--color-border)] bg-[var(--color-surface-neutral)] backdrop-blur-xl px-4 pt-6 pb-2 text-base text-[var(--color-text)] transition-all duration-300 focus:border-[var(--color-accent)] focus:ring-2 focus:ring-[var(--color-accent)]/20 focus:shadow-[0_0_20px_rgba(6,182,212,0.08)] focus:outline-none hover:border-[rgba(0,0,0,0.15)]"
            />
            <label for="email" data-i18n="contact.email">Email</label>
          </div>

          <!-- Message — floating label -->
          <div class="floating-label-group">
            <textarea
              name="message"
              id="message"
              required
              rows="5"
              placeholder=" "
              class="contact-input block w-full rounded-xl border border-[var(--color-border)] bg-[var(--color-surface-neutral)] backdrop-blur-xl px-4 pt-6 pb-2 text-base text-[var(--color-text)] transition-all duration-300 focus:border-[var(--color-accent)] focus:ring-2 focus:ring-[var(--color-accent)]/20 focus:shadow-[0_0_20px_rgba(6,182,212,0.08)] focus:outline-none hover:border-[rgba(0,0,0,0.15)] resize-y"
            ></textarea>
            <label for="message" data-i18n="contact.message">Message</label>
          </div>

          <button
            type="submit"
            id="contact-submit"
            class="btn-amber-glass magnetic-btn group inline-flex items-center px-7 py-3.5 rounded-xl text-base font-semibold hover:scale-[1.02] cursor-pointer"
          >
            <span data-i18n="contact.send">Send message</span>
            <svg class="ml-2 w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
            </svg>
          </button>

          <!-- Success message -->
          <div id="form-success" class="hidden mt-4 p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-sm">
            Message sent successfully! We'll get back to you within 48 hours.
          </div>
          <!-- Error message -->
          <div id="form-error" class="hidden mt-4 p-4 rounded-xl bg-red-500/10 border border-red-500/20 text-red-400 text-sm">
            Something went wrong. Please try again or email us directly.
          </div>
        </form>

        <script>
          const form = document.getElementById('contact-form') as HTMLFormElement;
          const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement;
          const successMsg = document.getElementById('form-success');
          const errorMsg = document.getElementById('form-error');

          if (form) {
            form.addEventListener('submit', async (e) => {
              e.preventDefault();

              // Basic client-side validation
              const name = (form.querySelector('#name') as HTMLInputElement).value.trim();
              const email = (form.querySelector('#email') as HTMLInputElement).value.trim();
              const message = (form.querySelector('#message') as HTMLTextAreaElement).value.trim();

              if (!name || !email || !message) return;

              submitBtn.disabled = true;
              const btnText = submitBtn.querySelector('span');
              const origText = btnText?.textContent || '';
              if (btnText) btnText.textContent = 'Sending...';

              successMsg?.classList.add('hidden');
              errorMsg?.classList.add('hidden');

              try {
                const res = await fetch(form.action, {
                  method: 'POST',
                  headers: { 'Accept': 'application/json' },
                  body: new FormData(form),
                });

                if (res.ok) {
                  form.reset();
                  successMsg?.classList.remove('hidden');
                } else {
                  errorMsg?.classList.remove('hidden');
                }
              } catch {
                errorMsg?.classList.remove('hidden');
              } finally {
                submitBtn.disabled = false;
                if (btnText) btnText.textContent = origText;
              }
            });
          }
        </script>
      </div>

      <!-- Right: Contact info -->
      <div class="lg:pt-20" data-animate="fade-left">
        <div class="relative rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface-neutral)] backdrop-blur-xl p-8 sm:p-10 overflow-hidden">
          <!-- Top highlight line -->
          <div class="absolute top-0 left-[10%] right-[10%] h-px bg-gradient-to-r from-transparent via-black/[0.04] to-transparent"></div>
          <!-- Inner glow -->
          <div class="absolute -top-16 -right-16 w-40 h-40 rounded-full bg-cyan-500/[0.06] blur-[50px]"></div>

          <h3 class="relative text-lg font-semibold text-[var(--color-text)]" data-i18n="contact.info.title">Contact information</h3>

          <div class="relative mt-8 space-y-6">
            <!-- Email -->
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-[var(--color-accent-light)] flex items-center justify-center border border-[rgba(6,182,212,0.1)]">
                <svg class="w-5 h-5 text-[var(--color-accent)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                </svg>
              </div>
              <div>
                <p class="text-sm font-medium text-[var(--color-text)]">Email</p>
                <a href="mailto:contact@ealenterprises.com" class="mt-1 text-sm sm:text-base text-[var(--color-accent)] hover:underline break-all">
                  contact@ealenterprises.com
                </a>
              </div>
            </div>

            <!-- WhatsApp -->
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-[rgba(37,211,102,0.1)] flex items-center justify-center border border-[rgba(37,211,102,0.15)]">
                <svg class="w-5 h-5 text-[#25D366]" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
              </div>
              <div>
                <p class="text-sm font-medium text-[var(--color-text)]">WhatsApp</p>
                <a href="https://wa.me/4367764371363" target="_blank" rel="noopener noreferrer" class="mt-1 text-base text-[#25D366] hover:underline">
                  +43 677 6437 1363
                </a>
              </div>
            </div>

            <!-- Location -->
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-[var(--color-accent-light)] flex items-center justify-center border border-[rgba(6,182,212,0.1)]">
                <svg class="w-5 h-5 text-[var(--color-accent)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418" />
                </svg>
              </div>
              <div>
                <p class="text-sm font-medium text-[var(--color-text)]" data-i18n="contact.info.location">Location</p>
                <p class="mt-1 text-base text-[var(--color-text-muted)]" data-i18n="contact.info.locationValue">Remote — worldwide</p>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
