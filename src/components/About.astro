---
// About — the two people behind EAL. Replaces the earlier version of this
// section, which carried three abstract "principles" (quality / transparency /
// efficiency) and three stat counters. Both are gone: the principles said about
// the company what these two descriptions say about the people, and the stats
// were making a claim the page could not back.
//
// Photo, name, role and description are DELIBERATELY empty, marked slots. A
// founder bio is exactly the kind of content that reads as real because it
// cannot be guessed, so inventing one here would be the wrong kind of filler.
// Each slot carries its own brief so it is obvious what belongs in it.

const people = [
  { key: 'p1', delay: '1' },
  { key: 'p2', delay: '2' },
];
---

<section id="despre" class="relative py-24 sm:py-32 overflow-hidden section-transition">
  <!-- Section glow orbs -->
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute top-[20%] right-[-8%] w-[45%] h-[45%] rounded-full bg-indigo-500 opacity-[0.05] blur-[120px]"></div>
    <div class="absolute bottom-[5%] left-[10%] w-[30%] h-[30%] rounded-full bg-cyan-500 opacity-[0.04] blur-[100px]"></div>
  </div>

  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12 sm:mb-16" data-animate="fade-up">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-[var(--color-text)]" data-i18n="about.title">
        About us
      </h2>
    </div>

    <div class="grid gap-6 sm:gap-8 md:grid-cols-2">
      {people.map((p) => (
        <article
          class="person-card group relative flex flex-col rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface-neutral)] backdrop-blur-xl p-6 sm:p-8 overflow-hidden transition-all duration-400 hover:border-[rgba(6,182,212,0.2)] hover:shadow-[0_0_40px_rgba(6,182,212,0.06)] hover:-translate-y-1"
          data-animate="fade-up"
          data-stagger-delay={p.delay}
        >
          <!-- Top highlight hairline -->
          <div class="absolute top-0 left-[10%] right-[10%] h-px bg-gradient-to-r from-transparent via-black/[0.04] to-transparent"></div>
          <!-- Hover glow -->
          <div class="absolute -top-8 -right-8 w-24 h-24 rounded-full bg-cyan-500/0 group-hover:bg-cyan-500/[0.06] blur-[30px] transition-all duration-500"></div>

          <!-- Photo slot. Replace the whole block with an <img> once the
               portrait exists; the brief below says what to shoot. -->
          <div class="person-photo relative flex aspect-[4/3] w-full flex-col justify-end rounded-xl border border-dashed border-[rgba(8,145,178,0.35)] bg-[rgba(8,145,178,0.04)] p-4">
            <svg class="absolute left-4 top-4 h-5 w-5 text-[var(--color-accent)] opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.827 6.175A2.31 2.31 0 015.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 00-1.134-.175 2.31 2.31 0 01-1.64-1.055l-.822-1.316a2.192 2.192 0 00-1.736-1.039 48.774 48.774 0 00-5.232 0 2.192 2.192 0 00-1.736 1.039l-.821 1.316z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 12.75a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0zM18.75 10.5h.008v.008h-.008V10.5z" />
            </svg>
            <p class="text-xs leading-relaxed text-[var(--color-text-muted)]" data-i18n="about.team.photoBrief">
              Photo to shoot: portrait, daylight, plain background, looking into the lens. Same framing for both.
            </p>
          </div>

          <p class="mt-6 text-2xl font-semibold text-[var(--color-text)]" data-i18n={`about.team.${p.key}.name`}>
            [Name]
          </p>
          <p class="mt-1 text-sm font-medium uppercase tracking-wider text-[var(--color-accent)]" data-i18n={`about.team.${p.key}.role`}>
            [Role]
          </p>
          <p class="mt-4 text-base leading-relaxed text-[var(--color-text-muted)]" data-i18n={`about.team.${p.key}.bio`}>
            [About 60 to 70 words: what you do, what you have built, and what a client gets when they work with you.]
          </p>
        </article>
      ))}
    </div>
  </div>

  <!-- Bottom gradient transition -->
  <div class="absolute bottom-0 left-0 right-0 h-16 bg-gradient-to-t from-[#f0fdfa] to-transparent pointer-events-none"></div>
</section>
