---
// About — built from the client's own document ("ANALYSE DER WEBSITE EAL"),
// which asks for: a photo plus a short profile of the two people, the heading
// "Unsere Grundsätze" replaced (his pick from the alternatives: "Was uns
// antreibt"), the belief sentence, and the three principles rewritten.
//
// Layout follows the "Meet The Founders" reference he chose: one wide band of
// both of them, then the two people side by side underneath, then what drives
// the studio. The photo is theirs, cropped waist-up and exposure-corrected so
// the faces are not sitting under a bright sky - no retouching of the people.
//
// Name, role and bio stay as visibly marked slots until they write them.

// p1 carries a portrait; p2 keeps a marked slot until he has one he likes.
// The portrait is a skin-retouch of the same photo the band comes from, so the
// two images sit together. Only p1 was retouched - p2's likeness is his own
// call, and nothing was run on it.
const people = [
  { key: 'p1', delay: '1', photo: '/images/about/person-1.jpg' },
  { key: 'p2', delay: '2', photo: null },
];

const principles = [
  { key: 'principle1', delay: '1' },
  { key: 'principle2', delay: '2' },
  { key: 'principle3', delay: '3' },
];
---

<section id="despre" class="relative py-24 sm:py-32 overflow-hidden section-transition">
  <!-- Section glow orbs -->
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute top-[20%] right-[-8%] w-[45%] h-[45%] rounded-full bg-indigo-500 opacity-[0.05] blur-[120px]"></div>
    <div class="absolute bottom-[5%] left-[10%] w-[30%] h-[30%] rounded-full bg-cyan-500 opacity-[0.04] blur-[100px]"></div>
  </div>

  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-10 sm:mb-14" data-animate="fade-up">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-[var(--color-text)]" data-i18n="about.title">
        About us
      </h2>
    </div>

    <!-- The pair, one wide band -->
    <figure class="founders-band relative overflow-hidden rounded-2xl border border-[var(--color-border)]" data-animate="fade-up">
      <img
        src="/images/about/founders.jpg"
        alt=""
        width="2000"
        height="974"
        loading="lazy"
        decoding="async"
        class="block h-full w-full object-cover"
      />
      <div class="pointer-events-none absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-black/70 via-black/30 to-transparent"></div>
      <figcaption class="absolute bottom-0 left-0 right-0 p-5 sm:p-6 text-left text-sm font-medium text-white" data-i18n="about.photoCaption">
        Luca and [partner], the two people behind EAL.
      </figcaption>
    </figure>

    <!-- The two of them, side by side -->
    <div class="mt-10 grid gap-8 sm:gap-10 md:grid-cols-2 md:gap-14">
      {people.map((p) => (
        <div data-animate="fade-up" data-stagger-delay={p.delay}>
          {p.photo ? (
            <img
              src={p.photo}
              alt=""
              width="600"
              height="800"
              loading="lazy"
              decoding="async"
              class="mb-6 w-[132px] rounded-xl border border-[var(--color-border)] object-cover sm:w-[152px]"
            />
          ) : (
            <!-- No visible placeholder. An empty dashed box reads as a broken
                 page rather than as a slot waiting to be filled. The spacer
                 keeps the same footprint so both names stay on one line; drop
                 it and add an <img> when the second portrait exists. -->
            <div class="person-slot mb-6 w-[132px] sm:w-[152px]" aria-hidden="true"></div>
          )}
          <p class="text-2xl font-semibold text-[var(--color-text)]" data-i18n={`about.team.${p.key}.name`}>
            [Name]
          </p>
          <p class="mt-1 text-sm font-medium uppercase tracking-wider text-[var(--color-accent)]" data-i18n={`about.team.${p.key}.role`}>
            [Role]
          </p>
          <p class="mt-4 text-base leading-relaxed text-[var(--color-text-muted)]" data-i18n={`about.team.${p.key}.bio`}>
            [About 60 to 70 words: what this person does, what they have built, and what a client gets from working with them.]
          </p>
        </div>
      ))}
    </div>

    <!-- What drives the studio. The belief line is set at statement size - it is
         the one thing in this section worth reading slowly - and the three
         principles sit on the same 1px hairline rails the price ledger uses, so
         the two sections speak the same language. No bullet dots: a coloured
         disc in front of a heading carries no information, same family as the
         trailing arrows and the 01/02/03 numbering already refused. -->
    <div class="mt-16 sm:mt-20 border-t border-[var(--color-border)] pt-12 sm:pt-16" data-animate="fade-up">
      <p class="text-xs font-medium uppercase tracking-[0.18em] text-[var(--color-accent)]" data-i18n="about.drive.title">
        What drives us
      </p>
      <p
        class="drive-statement mt-5 max-w-4xl font-bold tracking-[-0.02em] text-[var(--color-text)]"
        data-i18n="about.drive.text"
      >
        We believe good software does not just work. It simplifies processes, wins people over and grows with what a company needs.
      </p>

      <ul class="principle-rail mt-14 grid md:grid-cols-3">
        {principles.map((p) => (
          <li class="principle" data-animate="fade-up" data-stagger-delay={p.delay}>
            <p class="text-xl sm:text-2xl font-semibold tracking-[-0.015em] text-[var(--color-text)]" data-i18n={`about.${p.key}.title`}>Principle</p>
            <p class="mt-3 text-[0.95rem] leading-relaxed text-[var(--color-text-muted)]" data-i18n={`about.${p.key}.desc`}>Description</p>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- Bottom gradient transition -->
  <div class="absolute bottom-0 left-0 right-0 h-16 bg-gradient-to-t from-[#f0fdfa] to-transparent pointer-events-none"></div>
</section>

<style>
  /* Wide on desktop, taller on phones so both faces stay readable when the
     band narrows. 2.05:1 is the crop the source photo was cut to. */
  .founders-band { aspect-ratio: 2.05 / 1; }

  @media (max-width: 640px) {
    .founders-band { aspect-ratio: 4 / 3; }
  }

  /* The empty portrait slot matches the filled one's footprint exactly, so the
     two columns stay level while one of them is still waiting for a photo. */
  .person-slot { aspect-ratio: 3 / 4; }

  /* The belief line is the statement of the section: big enough to slow the
     reader down, short enough to stay two or three lines in every language. */
  .drive-statement {
    font-size: clamp(1.45rem, 2.6vw, 2.15rem);
    line-height: 1.28;
  }

  /* Hairline rails, the same device the price ledger uses. Horizontal on
     phones, vertical from md up, and never a rule before the first item. */
  .principle-rail .principle {
    border-top: 1px solid var(--color-border);
    padding-top: 1.5rem;
  }
  .principle-rail .principle + .principle { margin-top: 2.25rem; }

  @media (min-width: 768px) {
    .principle-rail .principle {
      border-top: 0;
      border-left: 1px solid var(--color-border);
      padding: 0 2rem;
    }
    .principle-rail .principle:first-child { border-left: 0; padding-left: 0; }
    .principle-rail .principle:last-child { padding-right: 0; }
    .principle-rail .principle + .principle { margin-top: 0; }
  }
</style>
