---
// About — built from the client's own document ("ANALYSE DER WEBSITE EAL"),
// which asks for: a photo plus a short profile of the two people, the heading
// "Unsere Grundsätze" replaced (his pick from the alternatives: "Was uns
// antreibt"), the belief sentence, and the three principles rewritten.
//
// Layout: the two of them as ONE composition, not two mirrored rows. The first
// portrait breaks out to the left and sits large, the second is smaller, higher
// and to the right, and the brand ring runs behind both so the pair reads as a
// single system. Then the studio's one dark band, full bleed.

// The English text here is the pre-translation fallback the markup renders;
// every language, including English, is served from translations.json.
const people = [
  {
    key: 'p1',
    photo: '/images/about/person-1.jpg',
    name: 'Luca Dumitrascu',
    bio: 'Builds the sites and the software behind them, from a one page site for an electrician to a trading toolkit with its own backend.',
  },
  {
    key: 'p2',
    photo: '/images/about/person-2.jpg',
    name: 'Andrei Banu',
    bio: 'Takes a project past launch and keeps it there: updates, fixes, monitoring, and the next round of features.',
  },
];

const principles = [
  { key: 'principle1', delay: '1' },
  { key: 'principle2', delay: '2' },
  { key: 'principle3', delay: '3' },
];
---

<section id="despre" class="relative py-24 sm:py-32 overflow-hidden section-transition">
  <!-- Section glow orbs -->
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute top-[20%] right-[-8%] w-[45%] h-[45%] rounded-full bg-indigo-500 opacity-[0.05] blur-[120px]"></div>
    <div class="absolute bottom-[5%] left-[10%] w-[30%] h-[30%] rounded-full bg-cyan-500 opacity-[0.04] blur-[100px]"></div>
  </div>

  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <!-- The section's own name is the smallest type in it. The nav already says
         About; what the reader has not met yet is these two, so the NAMES carry
         the display size and this line steps back to a signpost. -->
    <h2 class="about-eyebrow" data-animate="fade-up" data-i18n="about.title">
      About us
    </h2>

    <div class="founders relative mt-10 sm:mt-14">
      <!-- The brand ring, at strength this time, spanning both of them: one
           portrait sits inside the arc, the other crosses it. It also fills the
           space above the bottom-aligned text, which was dead air before. -->
      <div class="founders-ring-wrap" aria-hidden="true">
        <img
          class="founders-ring"
          src="/images/hero/hero-ring-v5.webp"
          alt=""
          width="2000"
          height="2000"
          loading="lazy"
          decoding="async"
        />
      </div>

      {people.map((p, i) => (
        <article class:list={['person', `person--${i + 1}`]}>
          <figure class="person-photo" data-animate="fade-up">
            <img
              src={p.photo}
              alt={p.name}
              width="1000"
              height="1250"
              loading="lazy"
              decoding="async"
            />
            <span class="person-sheen" aria-hidden="true"></span>
          </figure>

          <div class="person-text" data-animate="fade-up" data-stagger-delay="1">
            <p class="person-name" data-i18n={`about.team.${p.key}.name`}>{p.name}</p>
            <p class="person-bio" data-i18n={`about.team.${p.key}.bio`}>{p.bio}</p>
          </div>
        </article>
      ))}
    </div>

    <!-- What drives the studio. The belief line is set at statement size - it is
         the one thing in this section worth reading slowly - and the three
         principles sit on the same 1px hairline rails the price ledger uses, so
         the two sections speak the same language. No bullet dots: a coloured
         disc in front of a heading carries no information, same family as the
         trailing arrows and the 01/02/03 numbering already refused. -->
    <div class="drive-panel relative mt-24 overflow-hidden py-14 sm:mt-32 sm:py-20" data-animate="fade-up">
      <div class="relative mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <p class="text-xs font-medium uppercase tracking-[0.18em] text-[#5ED9F0]" data-i18n="about.drive.title">
          What drives us
        </p>
        <!-- The client's sentence split at its own full stop: the claim above
             at statement size, the elaboration below at reading size. The hedge
             it opened with ("Wir glauben, dass" / "We believe that") is cut - it
             asked permission for a claim the sentence then makes anyway, and it
             was a third of the line. German now lands on one line instead of
             four. -->
        <p class="drive-statement mt-6 font-bold tracking-[-0.022em] text-white" data-i18n="about.drive.lead">
          Good software does not just work.
        </p>
        <p class="drive-rest mt-5 max-w-2xl text-white/70" data-i18n="about.drive.text">
          It simplifies processes, wins people over and grows with what a company needs.
        </p>

        <ul class="principle-rail mt-14 grid md:grid-cols-3">
          {principles.map((p) => (
            <li class="principle" data-animate="fade-up" data-stagger-delay={p.delay}>
              <p class="principle-title text-xl sm:text-2xl font-semibold tracking-[-0.015em] text-white" data-i18n={`about.${p.key}.title`}>Principle</p>
              <p class="mt-3 text-[0.95rem] leading-relaxed text-white/65" data-i18n={`about.${p.key}.desc`}>Description</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <!-- Bottom gradient transition -->
  <div class="absolute bottom-0 left-0 right-0 h-16 bg-gradient-to-t from-[#f0fdfa] to-transparent pointer-events-none"></div>
</section>

<style>
  /* How far the composition is allowed to break out of the 1024px column. It is
     whatever the viewport has spare on one side, capped at 96px, and it floors
     at 0 so nothing can ever overflow on a narrow desktop. */
  .founders {
    --about-bleed: clamp(0rem, calc((100vw - 64rem) / 2 - 1.5rem), 6rem);
  }

  /* The signpost. 11px against a 68px name is the contrast the section was
     missing; the site's other eyebrows use the same uppercase tracking, so this
     borrows the existing language rather than importing a mono face for it. */
  .about-eyebrow {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .person { display: grid; gap: 1.75rem; }
  .person + .person { margin-top: 3.5rem; }

  /* Portrait crop. 4:5 holds a person from the waist up. */
  .person-photo {
    position: relative;
    z-index: 1;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 1rem;
    border: 1px solid rgba(14, 116, 144, 0.34);
    box-shadow: 0 28px 70px -28px rgba(8, 51, 68, 0.32);
  }
  .person-photo img { display: block; height: 100%; width: 100%; object-fit: cover; }

  /* The inner top highlight has to sit ABOVE the photo, so it is a pseudo rather
     than an inset shadow on the frame, which the image would cover. */
  .person-photo::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.85);
    pointer-events: none;
  }

  /* The same diagonal sheen the glass buttons sweep on hover. */
  .person-sheen {
    position: absolute;
    inset: 0;
    background: linear-gradient(115deg, transparent 38%, rgba(255, 255, 255, 0.3) 50%, transparent 62%);
    transform: translateX(-115%);
    transition: transform 0.95s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
  }
  .person-photo:hover .person-sheen { transform: translateX(115%); }

  .person-name {
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    font-size: clamp(2.2rem, 4.8vw, 4.25rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: var(--color-text);
  }

  .person-bio {
    margin-top: 1.5rem;
    max-width: 34rem;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  /* The whole ring has to be in frame, or it reads as a smudge instead of as the
     mark. It sits in the gap the two portraits leave between them. */
  .founders-ring-wrap {
    position: absolute;
    top: 14%;
    left: 50%;
    width: min(460px, 108%);
    aspect-ratio: 1;
    transform: translateX(-50%);
    z-index: 0;
    pointer-events: none;
  }
  .founders-ring {
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0.32;
    animation: foundersRingSpin 96s linear infinite;
    transform-origin: 50% 50%;
    will-change: transform;
  }
  @keyframes foundersRingSpin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }

  @media (min-width: 768px) {
    .person {
      grid-template-columns: 0.86fr 1.14fr;
      gap: 4rem;
      align-items: end;
    }

    /* The first one reads top down: his text starts level with his face, which
       leaves the bottom of that column empty on purpose. */
    .person--1 {
      margin-left: calc(var(--about-bleed) * -1);
    }
    .person--1 .person-text {
      align-self: start;
      padding-top: 2.5rem;
    }

    /* The second one is smaller and on the other side, and only his PHOTO is
       pulled up, into the empty bottom the first row just left. Pulling the
       whole row up instead put the photo on top of the first bio. */
    .person--2 {
      grid-template-columns: 1.14fr 0.86fr;
      margin-right: calc(var(--about-bleed) * -1);
    }
    .person--2 .person-photo {
      order: 2;
      width: 80%;
      margin-top: -7rem;
      margin-left: auto;
    }
    .person--2 .person-text { order: 1; }
    .person + .person { margin-top: 2rem; }

    /* Wide enough that its left arc crosses the first portrait and its right
       arc crosses the second. A ring that touches neither is decoration. */
    .founders-ring-wrap {
      top: 4%;
      left: 50%;
      width: min(880px, 78%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .founders-ring { animation: none; }
    .person-sheen { transition: none; }
  }

  /* The one dark moment on a uniformly pale page, edge to edge instead of a
     rounded rectangle inside the column. Its content re-centres on the same
     1024px measure as the rest of the section. */
  .drive-panel {
    margin-inline: calc(50% - 50vw);
  }

  /* Claim across the full width of the panel, elaboration under it in a reading
     measure. The earlier two-column version halved the claim's width to 465px,
     which is what pushed it onto three lines - the grid was the problem, not
     the sentence. */
  .drive-statement {
    font-size: clamp(1.6rem, 3vw, 2.55rem);
    line-height: 1.18;
  }
  .drive-rest {
    font-size: 1.0625rem;
    line-height: 1.65;
  }

  /* The one dark block on the whole page. The site is uniformly pale, so this
     is the held breath - it makes the section land instead of reading as more
     text in the same colour. Navy is the brand's own ink (--color-text), not a
     new colour. */
  .drive-panel {
    background:
      radial-gradient(120% 140% at 8% 0%, #16324b 0%, transparent 60%),
      linear-gradient(160deg, #0c1a2a 0%, #08131f 100%);
  }

  /* Hairline rails, the same device the price ledger uses. Horizontal on
     phones, vertical from md up, and never a rule before the first item.
     On the dark panel the rule has to be a light hairline, not the page one. */
  .principle-rail .principle {
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    padding-top: 1.5rem;
  }
  .principle-rail .principle + .principle { margin-top: 2.25rem; }

  @media (min-width: 768px) {
    /* The three descriptions start on the same line whether a title wraps or
       not. Subgrid rather than a reserved two-line title: it costs nothing in
       the languages where no title wraps, and equalising the copy instead would
       mean rewriting it in six. */
    .principle-rail { grid-template-rows: auto auto; }
    .principle-rail .principle {
      display: grid;
      grid-template-rows: subgrid;
      grid-row: span 2;
    }
    @supports not (grid-template-rows: subgrid) {
      .principle-title { min-height: 4rem; }
    }

    .principle-rail .principle {
      border-top: 0;
      border-left: 1px solid rgba(255, 255, 255, 0.16);
      padding: 0 2rem;
    }
    .principle-rail .principle:first-child { border-left: 0; padding-left: 0; }
    .principle-rail .principle:last-child { padding-right: 0; }
    .principle-rail .principle + .principle { margin-top: 0; }
  }
</style>
